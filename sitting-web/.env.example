# Copia este archivo a .env.local para desarrollo en local:
#   cp .env.example .env.local
# En producción (Render u otro hosting), estas variables se configuran
# desde el panel del servicio — nunca en el código ni subidas a GitHub.

# Obligatoria. La contraseña única que usará todo el equipo para entrar.
# Se puede cambiar cuando se quiera sin tocar nada más del código.
TEAM_PASSWORD=

# Obligatoria. Cadena aleatoria larga solo para firmar la cookie de sesión
# (no es una contraseña que nadie escriba a mano). Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional. Cadena de conexión de la base de datos Postgres compartida.
# Sin ella, en local se usa automáticamente un archivo (.data/store.json)
# — no hace falta instalar Postgres para desarrollar. EN PRODUCCIÓN hace
# falta rellenarla: ese archivo local no sobrevive a un redespliegue en la
# mayoría de hostings.
DATABASE_URL=

# Opcionales y avanzadas — normalmente no hace falta tocarlas. Fuerzan SSL
# en la conexión a Postgres si la cadena de arriba no lo deja claro (Render
# ya lo detecta solo a través del propio DATABASE_URL, con lo que en Render
# no hacen falta):
# PGSSLMODE=require
# DATABASE_SSL=1
